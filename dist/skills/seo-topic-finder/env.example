# seo-topic-finder credentials
#
# Copy this file to ~/.seo-title-advisor.env (shared with seo-title-creator, so
# setting it up once covers both skills), or to .env.local in the project root.
#
#   cp env.example ~/.seo-title-advisor.env
#   chmod 600 ~/.seo-title-advisor.env
#
# Lookup order, first hit wins:
#   process.env > ./.env.local > ./.env > ~/.seo-title-advisor.env
#
# NEVER commit a filled-in copy. Add .env and .env.local to .gitignore first.
# Verify with: node scripts/check-setup.mjs --live

# --- Google Search Console (MANDATORY) --------------------------------------
# Four of the five opportunity signals are computed from this. Without it the
# skill refuses to produce candidates. Setup: references/setup-gsc.md
#
# Accepts a base64 blob, raw JSON on one line, or a path to the JSON key file.
# The blocking step people skip is adding the service account as a USER on the
# Search Console property. Everything else can be correct and every call still
# fails without it.
GSC_SERVICE_ACCOUNT_KEY=
# Domain property: sc-domain:example.com   URL prefix property: https://example.com/
GSC_SITE_URL=

# If a service account is already configured for GA4, this is picked up
# automatically and GSC_SERVICE_ACCOUNT_KEY can stay empty.
# GA4_SERVICE_ACCOUNT_KEY=

# --- Naver Search Ad keyword tool (MANDATORY for Korean target queries) ------
# Monthly search volume and competition for Korean queries. Excluded entirely
# for English targets: the panel is domestic and the number would measure
# almost nothing. Setup: references/setup-naver.md (5 min, no review queue)
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=

# --- SerpApi (OPTIONAL, never blocks) ---------------------------------------
# Exact positions and occupant type for candidate queries. Free tier is 250
# searches per month. Skip it and built-in web search takes over, losing only
# positional precision. Setup: references/setup-serp.md
SERPAPI_KEY=

# --- Output language --------------------------------------------------------
# Written by scripts/language.mjs on first run. Leave blank to be asked once.
# SEO_TITLE_LANG=ko
